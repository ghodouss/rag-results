#!/usr/bin/env bash
set -uo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
python_bin="$repo_root/.venv/bin/python"
runner="$repo_root/scripts/run_contractnli_full_dual_label_matrix.py"
conditions=(sturdy-a4-r2-ranked-windows bm25-top4)
generators=(google/gemini-2.5-flash openai/gpt-4o-mini)
judges=(anthropic/claude-haiku-4.5 anthropic/claude-sonnet-4.5)
pids=()

stop_children() {
  local pid
  for pid in "${pids[@]}"; do
    kill -INT "$pid" 2>/dev/null || true
  done
  wait 2>/dev/null || true
}
trap stop_children INT TERM

wait_for_group() {
  local failed=0
  local pid
  for pid in "${pids[@]}"; do
    if ! wait "$pid"; then
      failed=1
    fi
  done
  pids=()
  return "$failed"
}

cd "$repo_root"

"$python_bin" "$runner" --stage prepare

for condition in "${conditions[@]}"; do
  for generator in "${generators[@]}"; do
    "$python_bin" "$runner" \
      --stage generate \
      --conditions "$condition" \
      --generator-models "$generator" \
      --concurrency 8 &
    pids+=("$!")
  done
done
if ! wait_for_group; then
  echo "Generation stage incomplete; rerun this command to resume checkpoints." >&2
  exit 1
fi

"$python_bin" "$runner" --stage validate-generations

for condition in "${conditions[@]}"; do
  for generator in "${generators[@]}"; do
    for judge in "${judges[@]}"; do
      "$python_bin" "$runner" \
        --stage judge \
        --conditions "$condition" \
        --generator-models "$generator" \
        --judge-models "$judge" \
        --concurrency 8 &
      pids+=("$!")
    done
  done
done
if ! wait_for_group; then
  echo "Judgment stage incomplete; rerun this command to resume checkpoints." >&2
  exit 1
fi

"$python_bin" "$runner" --stage summarize
"$python_bin" "$runner" --stage validate
